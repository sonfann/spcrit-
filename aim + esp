local function getTargetInFOV()
    local nearestTarget = nil
    local shortestDistance2D = fovRadius
    local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local myCharacter = player.Character

    if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = myCharacter.HumanoidRootPart.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local hum = p.Character:FindFirstChild("Humanoid")
            if hum and hum.Health > 0 then
                
                local targetPos = p.Character.HumanoidRootPart.Position
                

                local dist3D = (targetPos - myPos).Magnitude
                if dist3D <= maxDistance then
                    

                    local screenPos, onScreen = camera:WorldToViewportPoint(targetPos)
                    if onScreen then
                        local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist2D < shortestDistance2D then
                            shortestDistance2D = dist2D
                            nearestTarget = p.Character.HumanoidRootPart
                        end
                    end
                end
            end
        end
    end
    return nearestTarget
end



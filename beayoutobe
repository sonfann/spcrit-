local _G_AutoUpload = false
local _G_AutoClaim = false
local _G_AutoRebirth = false

local uploadRemotes = {}
local claimRemotes = {}
local rebirthRemotes = {}

for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
    if obj:IsA("RemoteEvent") then
        local nameLower = string.lower(obj.Name)
        if string.find(nameLower, "upload") then
            table.insert(uploadRemotes, obj)
        elseif string.find(nameLower, "claim") or string.find(nameLower, "collect") then
            table.insert(claimRemotes, obj)
        elseif string.find(nameLower, "rebirth") then
            table.insert(rebirthRemotes, obj)
        end
    end
end

UploadBtn.MouseButton1Click:Connect(function()
    _G_AutoUpload = not _G_AutoUpload
    if _G_AutoUpload then
        UploadBtn.Text = "Đang Upload..."
        UploadBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while _G_AutoUpload do
                for _, remote in pairs(uploadRemotes) do pcall(function() remote:FireServer() end) end
                task.wait(0.5)
            end
        end)
    else
        UploadBtn.Text = "Bật Auto Upload"
        UploadBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

ClaimBtn.MouseButton1Click:Connect(function()
    _G_AutoClaim = not _G_AutoClaim
    if _G_AutoClaim then
        ClaimBtn.Text = "Đang Bào Tiền..."
        ClaimBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
        task.spawn(function()
            while _G_AutoClaim do
                for _, remote in pairs(claimRemotes) do pcall(function() remote:FireServer() end) end
                task.wait(0.1)
            end
        end)
    else
        ClaimBtn.Text = "Bật Auto Claim"
        ClaimBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

-- Logic chạy Auto Rebirth 
RebirthBtn.MouseButton1Click:Connect(function()
    _G_AutoRebirth = not _G_AutoRebirth
    if _G_AutoRebirth then
        RebirthBtn.Text = "Đang Auto Rebirth x10..."
        RebirthBtn.BackgroundColor3 = Color3.fromRGB(150, 0, 150)
        task.spawn(function()
            while _G_AutoRebirth do
                for _, remote in pairs(rebirthRemotes) do
                    -- Chuyển tham số truyền vào thành 10
                    pcall(function() remote:FireServer(50) end)
                end
                task.wait(1) -- Để nguyên 1 giây để server kịp xử lý và trừ tiền
            end
        end)
    else
        RebirthBtn.Text = "Bật Auto Rebirth (x10)"
        RebirthBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    end
end)

-- Bắt sự kiện bàn phím
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end -- Bỏ qua nếu đang chat
    
    if input.KeyCode == Enum.KeyCode.T then
        toggleMenu() -- Phím R: Ẩn/Hiện bảng Menu
    elseif input.KeyCode == Enum.KeyCode.Y then
        toggleFOV()  -- Phím T: Bật/Tắt Vòng tròn FOV
    elseif input.KeyCode == Enum.KeyCode.Q then
        toggleLock() -- Phím Q: Bật/Tắt Auto-Lock (Ngắm tự động)
    elseif input.KeyCode == Enum.KeyCode.I then
        toggleESP()  -- Phím E: Bật/Tắt ESP (Nhìn xuyên tường)
    end
end)
